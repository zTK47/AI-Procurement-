# OpenAI-compatible LiteLLM gateway
LITELLM_API_BASE=https://litellm.engines.aisl.science/v1
LITELLM_API_KEY=replace-with-your-gateway-key
LITELLM_MODEL=azure_ai/claude-haiku-5-5

# Optional: database (default sqlite:///./procurement.db) and parser (llm | rules)
# DATABASE_URL=sqlite:///./procurement.db
# DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
# PARSER=llm
